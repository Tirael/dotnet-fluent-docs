<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>FluentDocs</RootNamespace>
    <PackageId>FluentDocs</PackageId>
    <Description>Разбирает исходники валидаторов FluentValidation через Roslyn и XML-комментарии и формирует каталог настроек с журналом изменений.</Description>
    <IsPackable>true</IsPackable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
  </ItemGroup>
</Project>

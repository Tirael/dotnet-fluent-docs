<Project>
  <PropertyGroup>
    <FluentDocsContinueOnError>false</FluentDocsContinueOnError>
    <FluentDocsContinueOnError Condition="'$(FluentDocsFailOnError)' == 'false'">true</FluentDocsContinueOnError>
    <FluentDocsToolDll Condition="'$(FluentDocsToolDll)' == ''">$(MSBuildThisFileDirectory)..\tools\net10.0\FluentDocs.Tool.dll</FluentDocsToolDll>
  </PropertyGroup>

  <Target Name="GenerateFluentDocs"
          AfterTargets="Build"
          Condition="'$(FluentDocsEnabled)' == 'true' and '$(DesignTimeBuild)' != 'true' and '$(BuildingProject)' == 'true'">
    <Error Condition="!Exists('$(FluentDocsToolDll)')"
           Text="Инструмент FluentDocs не найден по пути '$(FluentDocsToolDll)'. Сначала соберите FluentDocs.Tool или задайте FluentDocsToolDll." />

    <ItemGroup>
      <_FluentDocsCompile Include="@(Compile->'%(FullPath)')" />
      <_FluentDocsRefs Include="@(ReferencePath->'%(FullPath)')" />
    </ItemGroup>

    <PropertyGroup>
      <_FluentDocsSourcesFile>$(IntermediateOutputPath)fluentdocs.sources.txt</_FluentDocsSourcesFile>
      <_FluentDocsRefsFile>$(IntermediateOutputPath)fluentdocs.refs.txt</_FluentDocsRefsFile>
      <_FluentDocsXmlArg></_FluentDocsXmlArg>
      <_FluentDocsXmlArg Condition="'$(DocumentationFile)' != '' and Exists('$(DocumentationFile)')">--xml "$(DocumentationFile)"</_FluentDocsXmlArg>
    </PropertyGroup>

    <WriteLinesToFile File="$(_FluentDocsSourcesFile)" Lines="@(_FluentDocsCompile)" Overwrite="true" Encoding="UTF-8" />
    <WriteLinesToFile File="$(_FluentDocsRefsFile)" Lines="@(_FluentDocsRefs)" Overwrite="true" Encoding="UTF-8" />

    <Error Condition="@(_FluentDocsCompile->Count()) == 0"
           Text="FluentDocs: не найдено исходных файлов @(Compile) для разбора Roslyn." />

    <Exec Command="dotnet exec &quot;$(FluentDocsToolDll)&quot; --sources-list &quot;$(_FluentDocsSourcesFile)&quot; --references-list &quot;$(_FluentDocsRefsFile)&quot; $(_FluentDocsXmlArg) --output &quot;$(FluentDocsOutputPath)&quot; --snapshot &quot;$(FluentDocsSnapshotPath)&quot;"
          ContinueOnError="$(FluentDocsContinueOnError)"
          LogStandardErrorAsError="true" />
  </Target>
</Project>

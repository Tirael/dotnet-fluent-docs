{
  "Mail": {
    "Host": "smtp.example.com",
    "Port": 587,
    "From": "noreply@example.com",
    "EnableTls": true,
    "TimeoutSeconds": 30,
    "Retry": {
      "MaxAttempts": 3,
      "DelayMilliseconds": 200
    },
    "Recipients": [
      {
        "Email": "ops@example.com",
        "Name": "Operations"
      }
    ],
    "AllowedSenderPatterns": [
      "^noreply@example\\.com$"
    ]
  },
  "Storage": {
    "Provider": "Local",
    "RootPath": "/var/demo/data",
    "MaxFileSizeBytes": 1048576,
    "BucketName": ""
  }
}
